# Prevent automatic execution of install scripts (supply chain protection)
# @sentry/cli is the only dependency with a true postinstall — it is re-run
# explicitly via the project-level postinstall script in package.json.
ignore-scripts=true

# Always save exact package versions
save-exact=true

# Enable npm security auditing and fail on high or critical findings
audit=true
audit-level=high

# Enforce strict Node.js engine validation
engine-strict=false

# Prefer cached packages in CI
prefer-offline=false

# Disable unnecessary external requests
fund=false

# Use the official npm registry
registry=https://registry.npmjs.org/

# Enable strict SSL validation
strict-ssl=true

# Reduce noisy logs in CI/CD
loglevel=error

# Prevent automatic package suggestions
update-notifier=false

# Reproducible installs with lockfile v3 (SHA-512 integrity hashes)
package-lock=true
lockfile-version=3
