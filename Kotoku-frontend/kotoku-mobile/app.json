{
  "expo": {
    "name": "Kotoku",
    "slug": "kotoku-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "kotoku",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kotoku.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kotoku.mobile"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Kotoku needs camera access to capture evidence photos and ID documents."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Kotoku needs photo library access to attach evidence from your gallery."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Kotoku needs microphone access to record voice summaries."
        }
      ],
      "expo-sqlite",
      "expo-media-library",
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
