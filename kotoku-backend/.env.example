DJANGO_SECRET_KEY=replace-with-a-strong-secret-key-of-at-least-32-bytes
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Production example:
# DJANGO_ALLOWED_HOSTS=api.kotoku-app.com,healthcheck.railway.app
DJANGO_SETTINGS_MODULE=config.settings.local
# Production: set this to a non-obvious path and keep Django admin MFA enabled.
# Example: DJANGO_ADMIN_PATH=kotoku-control-<random>/
DJANGO_ADMIN_PATH=admin/
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://kotoku-app.com,https://www.kotoku-app.com
CORS_ALLOW_CREDENTIALS=true
AUTH_REFRESH_COOKIE_NAME=kotoku_refresh
AUTH_REFRESH_COOKIE_PATH=/api/auth/
AUTH_REFRESH_COOKIE_SAMESITE=Lax
# Production defaults this to true when DJANGO_DEBUG=false.
AUTH_REFRESH_COOKIE_SECURE=false
EVIDENCE_VIEW_URL_TTL_SECONDS=900
DB_NAME=kotoku
DB_USER=kotoku
DB_PASSWORD=kotoku
DB_HOST=db
DB_PORT=5432
DATABASE_URL=postgresql://kotoku:kotoku@db:5432/kotoku
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
BILLING_ENFORCEMENT_FAIL_OPEN=false
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_STORAGE_BUCKET_NAME=kotoku-local
AWS_ENDPOINT_URL_S3=http://minio:9000
# Optional externally reachable host for presigned browser/device upload URLs
# when storage lives behind Docker or a private hostname.
AWS_S3_EXTERNAL_URL=
MINIO_ROOT_USER=kotokuadmin
MINIO_ROOT_PASSWORD=kotokuadmin123
# --- Infobip (primary SMS provider) ---
INFOBIP_API_KEY=replace-me
INFOBIP_BASE_URL=https://xxxxx.api.infobip.com  # Your account-specific base URL from Infobip dashboard
INFOBIP_SMS_SENDER=                             # Alphanumeric sender ID registered in Infobip
INFOBIP_WHATSAPP_NUMBER=                        # WhatsApp business number linked in Infobip (e.g. +233XXXXXXXXX)
INFOBIP_WHATSAPP_TEMPLATE_NAME=                 # Approved WA authentication template name — set after template approval
INFOBIP_SMS_TIMEOUT_SECONDS=30                  # Seconds before SMS falls back to WhatsApp
INFOBIP_WEBHOOK_SECRET=replace-with-random-secret  # Set in Railway + Infobip DLR callback URL as ?secret=<value>

# --- Africa's Talking (cold standby — set SMS_BACKEND=africastalking to re-enable) ---
SMS_API_KEY=replace-me
# SMS_SENDER_ID=KOTOKU  # Must be registered in AT dashboard
# SMS_BACKEND=console   # Print OTPs to terminal (local dev only)
# Paystack — test keys by default; swap for live keys when account is approved (no code change)
PAYSTACK_SECRET_KEY=sk_test_replace-me
PAYSTACK_PUBLIC_KEY=pk_test_replace-me
PAYSTACK_WEBHOOK_SECRET=replace-me
# Paystack plan codes — set after creating plans in the Paystack dashboard (Products → Plans)
PAYSTACK_PLAN_CODE_PERSONAL_BASIC=
PAYSTACK_PLAN_CODE_PERSONAL_PLUS=
PAYSTACK_PLAN_CODE_PERSONAL_PROTECT=
PAYSTACK_PLAN_CODE_ENTERPRISE_STANDARD=
PAYSTACK_PLAN_CODE_ENTERPRISE_PLUS=
# Deep-link URL the mobile app handles after Paystack checkout
PAYSTACK_CALLBACK_URL=kotoku://payment/callback
# Deep-link base URL embedded in identity invite SMS messages sent to Party B
PARTY_INVITE_DEEP_LINK_BASE=kotoku://invite/
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
